---
import { siteConfig } from "@/data/portfolio";
---

<section id="contact" class="border-t border-line bg-bg-deep/50 px-6 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-accent">
        Contact
      </p>
      <h2 class="font-display text-3xl font-semibold text-ink sm:text-4xl">
        Let's build something durable
      </h2>
      <p class="mt-4 text-muted leading-relaxed">
        Open to senior engineering roles, consulting, and collaborations that
        care about craft.
      </p>
    </div>

    <div
      class="reveal mx-auto mt-12 flex max-w-2xl flex-col items-center gap-8"
    >
      <a
        href={`mailto:${siteConfig.email}`}
        class="font-display text-xl font-semibold text-ink transition-colors hover:text-accent sm:text-2xl"
      >
        {siteConfig.email}
      </a>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
        >
          LinkedIn
        </a>
        <a
          href={siteConfig.social.medium}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
        >
          Medium
        </a>
        <a
          href={siteConfig.cvPath}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center bg-accent px-5 py-2.5 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
        >
          Download CV
        </a>
      </div>

      <p class="text-sm text-muted">
        {siteConfig.location} · {siteConfig.phone}
      </p>
    </div>
  </div>
</section>
