---
import {
  siteConfig,
  techStack,
} from "@/data/portfolio";
---

<section
  id="top"
  class="relative flex min-h-[100svh] items-end overflow-hidden px-6 pb-16 pt-28 sm:pb-20 sm:pt-32"
>
  <div class="absolute inset-0 -z-10" style="background: var(--hero-wash);" aria-hidden="true"></div>

  {/* Full-bleed typographic plane as visual anchor */}
  <div
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
    aria-hidden="true"
  >
    <p
      class="hero-animate absolute -right-8 -bottom-6 select-none font-display text-[clamp(7rem,30vw,20rem)] font-bold leading-none tracking-tighter text-accent/[0.08] sm:-right-12 sm:-bottom-10"
    >
      CS
    </p>

    {/* Soft circle — cropped left, never reads as media */}
    <div
      class="absolute -left-[18%] top-[8%] h-[58vmin] w-[58vmin] rounded-full border border-line/50"
    >
    </div>

    {/* Corner brackets — clearly ornamental, not an image frame */}
    <div class="absolute bottom-[18%] right-[6%] h-24 w-24 sm:h-32 sm:w-32">
      <span class="absolute left-0 top-0 h-8 w-8 border-l border-t border-accent/35 sm:h-10 sm:w-10"></span>
      <span class="absolute bottom-0 right-0 h-8 w-8 border-b border-r border-accent/35 sm:h-10 sm:w-10"></span>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl">
    <p
      class="hero-animate hero-animate-delay-1 mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-accent"
    >
      {siteConfig.role}
    </p>

    <h1
      class="hero-animate hero-animate-delay-2 font-display text-[clamp(2.75rem,9vw,6.5rem)] font-semibold leading-[1.05] tracking-tight text-ink"
    >
      {siteConfig.name}
    </h1>

    <p
      class="hero-animate hero-animate-delay-3 mt-6 max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl"
    >
      I design and ship durable web and mobile systems — architecture, delivery,
      and the engineering culture that keeps them healthy.
    </p>

    <div
      class="hero-animate hero-animate-delay-4 mt-10 flex flex-col gap-3 sm:flex-row sm:items-center"
    >
      <a
        href="#experience"
        class="inline-flex items-center justify-center bg-accent px-7 py-3.5 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
      >
        View experience
      </a>
      <a
        href={siteConfig.cvPath}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center border border-line bg-surface/70 px-7 py-3.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Download CV
      </a>
    </div>

    <ul
      class="hero-animate hero-animate-delay-4 mt-12 flex flex-wrap gap-x-5 gap-y-2 border-t border-line/80 pt-6 text-sm text-muted"
    >
      {
        techStack.map((tech) => (
          <li class="after:ml-5 after:text-line after:content-['/'] last:after:content-none">
            {tech}
          </li>
        ))
      }
    </ul>
  </div>
</section>
