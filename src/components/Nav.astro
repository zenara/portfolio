---
import { siteConfig, navLinks } from "@/data/portfolio";
---

<header
  class="nav-shell fixed inset-x-0 top-0 z-50 border-b border-transparent"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4"
  >
    <a
      href="#top"
      class="font-display text-lg font-semibold tracking-tight text-ink"
    >
      {siteConfig.shortName}<span class="text-accent">.</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-muted transition-colors hover:text-ink"
              {...(link.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden items-center gap-3 md:flex">
      <a
        href={siteConfig.cvPath}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-muted transition-colors hover:text-ink"
      >
        CV
      </a>
      <a
        href="#contact"
        class="inline-flex items-center bg-accent px-4 py-2 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
      >
        Contact
      </a>
    </div>

    <details class="relative md:hidden">
      <summary
        class="list-none cursor-pointer rounded-sm border border-line px-3 py-2 text-sm text-ink marker:content-none [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        Menu
      </summary>
      <div
        class="absolute right-0 mt-3 w-56 border border-line bg-surface p-3 shadow-sm"
      >
        <ul class="flex flex-col gap-1">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block px-3 py-2 text-sm text-muted hover:bg-accent-soft hover:text-ink"
                  {...(link.external
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="mt-2 border-t border-line pt-2">
            <a
              href={siteConfig.cvPath}
              target="_blank"
              rel="noopener noreferrer"
              class="block px-3 py-2 text-sm text-muted hover:text-ink"
            >
              Download CV
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>
